# ── Ollama (IA local) ─────────────────────────────────────────────────────────
# Endereço onde o Ollama está rodando (padrão: http://localhost:11434)
OLLAMA_BASE_URL=http://ollama:11434

# Modelo a usar. Execute "ollama list" para ver os modelos disponíveis.
# Modelos recomendados: llama3, llama3:70b, mistral, gemma2, phi3
OLLAMA_MODEL=llama3:8b

# ── Segurança ─────────────────────────────────────────────────────────────────
SECRET_KEY=your_secret_key_here_change_in_production

# ── Banco de dados ────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./juridico.db

# ── Sessão ────────────────────────────────────────────────────────────────────
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Upload ────────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
