# ── JurisAI — variáveis para docker-compose ──────────────────────────────────
# Copie para .env e ajuste conforme necessário:
#   cp .env.example .env

# Modelo Ollama a usar (deve estar baixado no container ollama)
# Opções: llama3, llama3:70b, mistral, gemma2, phi3
OLLAMA_MODEL=llama3

# Chave secreta JWT — TROQUE em produção!
SECRET_KEY=troque-esta-chave-em-producao-use-algo-aleatorio
